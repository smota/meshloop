{
  "schema": "nodecode-meshloop/cli-contract/1",
  "about": "Every field of `meshloop <verb> --json` that the nodecode-meshloop cell reads. The cell checks each response against this file, and crates/meshloop-cli/tests/nodecode_cell_contract.rs runs the verbs on fixture repositories and asserts the same paths and types. A path is dot-separated; `[]` means every element of that array. A type ending in `?` may also be null. A field with \"optional\": true may be absent, and has its type when present. `command` names the envelope's command when it is not meshloop:<first argv word>. `graph` lists the fields the cell reads of a plan (the plan file review-plan shows, and data.graph of plan and review-plan). accept, and integrate without --deliverable, answer text, not JSON: the cell reads their exit code, then reads back what they recorded through inspect_attempts and status. A case or field with \"pending_kernel\" names what the #139 kernel build adds and the cell reads: the value says what the cell assumes, and the coordinator aligns the name with the kernel's actual shape (ADR 0038, amendment 2026-11-10). priors_attempts holds the fields only /meshloop learn reads, so an older binary still answers report and accept while learn fails closed.",
  "envelope": [
    { "path": "ok", "type": "boolean" },
    { "path": "command", "type": "string" }
  ],
  "graph": [
    { "path": "graph_id", "type": "string" },
    { "path": "nodes", "type": "array" },
    { "path": "nodes[].id", "type": "integer" },
    { "path": "nodes[].description", "type": "string" },
    { "path": "nodes[].depends_on", "type": "array" },
    { "path": "nodes[].tier", "type": "string?" }
  ],
  "cases": {
    "error": {
      "argv": ["inspect", "--graph", "contract-missing-graph"],
      "ok": false,
      "fields": [
        { "path": "error", "type": "string" }
      ]
    },
    "doctor": {
      "argv": ["doctor"],
      "ok": true,
      "fields": [
        { "path": "data.config", "type": "string?" },
        { "path": "data.harnesses_ready", "type": "boolean" },
        { "path": "data.harnesses", "type": "array" },
        { "path": "data.harnesses[].name", "type": "string" },
        { "path": "data.harnesses[].dispatchable", "type": "boolean" },
        { "path": "data.harnesses[].reason", "type": "string?" },
        { "path": "data.store_ignored", "type": "boolean" },
        { "path": "data.warnings", "type": "array" }
      ]
    },
    "status_empty": {
      "argv": ["status"],
      "ok": true,
      "fields": [
        { "path": "data.runs", "type": "array" }
      ]
    },
    "status": {
      "argv": ["status"],
      "ok": true,
      "fields": [
        { "path": "data.graph_id", "type": "string" },
        { "path": "data.plan_state", "type": "string" },
        { "path": "data.summary.attempts", "type": "integer" },
        { "path": "data.summary.retries", "type": "integer" },
        { "path": "data.nodes", "type": "array" },
        { "path": "data.nodes[].id", "type": "integer" },
        { "path": "data.nodes[].state", "type": "string" },
        { "path": "data.nodes[].waiting_for", "type": "string?" },
        { "path": "data.nodes[].description", "type": "string" },
        { "path": "data.nodes[].live", "type": "string?" },
        { "path": "data.awaiting_acceptance", "type": "array" },
        { "path": "data.driver", "type": "string?", "optional": true }
      ]
    },
    "inspect": {
      "argv": ["inspect"],
      "ok": true,
      "fields": [
        { "path": "data.session_id", "type": "string" },
        { "path": "data.status", "type": "string" },
        { "path": "data.plan_state", "type": "string" },
        { "path": "data.nodes", "type": "array" },
        { "path": "data.nodes[].id", "type": "integer" },
        { "path": "data.nodes[].state", "type": "string" },
        { "path": "data.nodes[].waiting_for", "type": "string?" },
        { "path": "data.nodes[].description", "type": "string" }
      ]
    },
    "inspect_attempts": {
      "argv": ["inspect", "--attempts"],
      "ok": true,
      "fields": [
        { "path": "data.session_id", "type": "string" },
        { "path": "data.status", "type": "string" },
        { "path": "data.plan_state", "type": "string" },
        { "path": "data.nodes", "type": "array" },
        { "path": "data.nodes[].id", "type": "integer" },
        { "path": "data.nodes[].state", "type": "string" },
        { "path": "data.nodes[].attempts", "type": "array" },
        { "path": "data.nodes[].attempts[].harness", "type": "string" },
        { "path": "data.nodes[].attempts[].model_ref", "type": "string" },
        { "path": "data.nodes[].attempts[].outcome", "type": "string" },
        { "path": "data.nodes[].attempts[].evidence", "type": "array" },
        { "path": "data.nodes[].attempts[].evidence[].kind", "type": "string" },
        { "path": "data.nodes[].attempts[].evidence[].tool", "type": "string?" },
        { "path": "data.nodes[].attempts[].evidence[].exit_code", "type": "integer?" },
        { "path": "data.nodes[].attempts[].evidence[].summary_redacted", "type": "string?" }
      ]
    },
    "priors_attempts": {
      "argv": ["inspect", "--attempts", "--graph", "gcell"],
      "ok": true,
      "pending_kernel": "#139 adds dispatch_mode, model_passed and check_result to every attempt (learning-plane.md, New read-only attempt fields) and, asked by the cell, the node's tier, so the fold keys evidence as routing does",
      "fields": [
        { "path": "data.nodes[].tier", "type": "string?", "pending_kernel": "the plan node's tier, Tier1|Tier2|Tier3, null when the plan names none (routing then keys Tier2); not in inspect before #139" },
        { "path": "data.nodes[].attempts[].attempt_id", "type": "integer" },
        { "path": "data.nodes[].attempts[].dispatch_mode", "type": "string?", "pending_kernel": "\"subprocess\" (DispatchMode, exhaustive match)" },
        { "path": "data.nodes[].attempts[].model_passed", "type": "boolean?", "pending_kernel": "attempts.model_passed, null before #139" },
        { "path": "data.nodes[].attempts[].check_result", "type": "string?", "pending_kernel": "\"passed\", \"failed\" or null" }
      ]
    },
    "priors_show": {
      "argv": ["priors", "show"],
      "command": "meshloop:priors-show",
      "ok": true,
      "pending_kernel": "meshloop priors show --json: whether promoted priors are in effect, their digest, and advisory_routing counts; names assumed by the cell",
      "fields": [
        { "path": "data.in_effect", "type": "boolean", "pending_kernel": "true when the latest ledger row is an accept whose priors apply" },
        { "path": "data.priors_sha256", "type": "string?", "optional": true, "pending_kernel": "the promoted bytes' SHA-256" },
        { "path": "data.routing.attempts", "type": "integer", "optional": true, "pending_kernel": "advisory_routing rows" },
        { "path": "data.routing.changed_top", "type": "integer", "optional": true, "pending_kernel": "advisory_routing rows with changed_top" }
      ]
    },
    "priors_check": {
      "argv": ["priors", "check", "--file", "advisory-priors.json"],
      "command": "meshloop:priors-check",
      "ok": true,
      "pending_kernel": "meshloop priors check --file F --json: read-only; the loader's verdict on F; names assumed by the cell",
      "fields": [
        { "path": "data.file_fault", "type": "string?", "pending_kernel": "a file-level code (too_large, not_json, wrong_schema, wrong_version), null when none" },
        { "path": "data.usable", "type": "integer", "optional": true, "pending_kernel": "entries routing would use once promoted" },
        { "path": "data.ignored", "type": "integer", "optional": true, "pending_kernel": "entries the loader or accept would ignore" },
        { "path": "data.diagnostics", "type": "array" },
        { "path": "data.diagnostics[].code", "type": "string" },
        { "path": "data.diagnostics[].detail", "type": "string?", "optional": true }
      ]
    },
    "integrate_preview": {
      "argv": ["inspect"],
      "ok": true,
      "fields": [
        { "path": "data.git_export", "type": "object" },
        { "path": "data.git_export.worktree_path", "type": "string" },
        { "path": "data.git_export.branch_ref", "type": "string" },
        { "path": "data.git_export.commit_sha", "type": "string" }
      ]
    },
    "plan": {
      "argv": ["plan", "--objective", "contract objective", "--out", "planned.json"],
      "ok": true,
      "fields": [
        { "path": "data.path", "type": "string" },
        { "path": "data.graph", "type": "object" }
      ]
    },
    "review_plan": {
      "argv": ["review-plan", "--plan", "plan.json", "--accept", "--as", "contract-person"],
      "ok": true,
      "fields": [
        { "path": "data.decision", "type": "string" },
        { "path": "data.plan_state", "type": "string" },
        { "path": "data.graph_id", "type": "string" },
        { "path": "data.as", "type": "string?" },
        { "path": "data.graph", "type": "object" }
      ]
    },
    "run_detached": {
      "argv": ["run", "--plan", "plan.json", "--detach"],
      "ok": true,
      "fields": [
        { "path": "data.graph_id", "type": "string" },
        { "path": "data.status", "type": "string" },
        { "path": "data.detached", "type": "boolean" },
        { "path": "data.driver_log", "type": "string" }
      ]
    },
    "resume_detached": {
      "argv": ["resume", "--detach", "--graph", "gcell"],
      "ok": true,
      "fields": [
        { "path": "data.graph_id", "type": "string" },
        { "path": "data.status", "type": "string" },
        { "path": "data.detached", "type": "boolean" },
        { "path": "data.driver_log", "type": "string" }
      ]
    },
    "resume_driver_alive": {
      "argv": ["resume", "--detach", "--graph", "gcell"],
      "ok": false,
      "fields": [
        { "path": "error", "type": "string" }
      ]
    },
    "cancel": {
      "argv": ["cancel", "--graph", "gcancel"],
      "ok": true,
      "fields": [
        { "path": "data.session_id", "type": "string" },
        { "path": "data.status", "type": "string" }
      ]
    },
    "events": {
      "argv": ["events", "--graph", "gcell", "--after", "0", "--limit", "200"],
      "ok": true,
      "fields": [
        { "path": "data.graph_id", "type": "string" },
        { "path": "data.plan_state", "type": "string" },
        { "path": "data.ledger_id", "type": "string" },
        { "path": "data.last_seq", "type": "integer" },
        { "path": "data.max_seq", "type": "integer" },
        { "path": "data.more", "type": "boolean" },
        { "path": "data.nodes", "type": "object" },
        { "path": "data.latest", "type": "object" },
        { "path": "data.events", "type": "array" },
        { "path": "data.events[].seq", "type": "integer" },
        { "path": "data.events[].task", "type": "integer" },
        { "path": "data.events[].from", "type": "string" },
        { "path": "data.events[].to", "type": "string" },
        { "path": "data.events[].event", "type": "string" },
        { "path": "data.events[].superseded", "type": "boolean" },
        { "path": "data.events[].evidence_path", "type": "string?" }
      ]
    },
    "workspace_inventory": {
      "argv": ["workspace", "inventory"],
      "command": "meshloop:workspace-inventory",
      "ok": true,
      "fields": [
        { "path": "data.entries", "type": "array" },
        { "path": "data.entries[].graph_id", "type": "string?" },
        { "path": "data.entries[].ownership", "type": "string" }
      ]
    }
  }
}
